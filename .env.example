# Compose 宿主机路径；相对路径以 compose.yaml 所在目录为基准。
# 目录中须包含 config.json、yt-dlp.conf 和 yta-dlp.conf。
DROPLOAD_CONFIG_DIR=.
DROPLOAD_URLS_PATH=./urls
DROPLOAD_TMP_PATH=./tmp
DROPLOAD_FILES_PATH=./files
DROPLOAD_LOGS_PATH=./logs
DROPLOAD_DATA_PATH=./data

# 自动创建的绑定目录通常属于 root。目录已授权时可改为实际 UID/GID。
DROPLOAD_UID=0
DROPLOAD_GID=0
