# Compose 宿主机路径；相对路径以 compose.yaml 所在目录为基准。
# 目录中须包含 config.json、yt-dlp.conf 和 yta-dlp.conf。
PYYOUTUBEDL_CONFIG_DIR=.
PYYOUTUBEDL_URLS_PATH=./urls
PYYOUTUBEDL_TMP_PATH=./tmp
PYYOUTUBEDL_FILES_PATH=./files
PYYOUTUBEDL_LOGS_PATH=./logs
PYYOUTUBEDL_DATA_PATH=./data

# 自动创建的绑定目录通常属于 root。目录已授权时可改为实际 UID/GID。
PYYOUTUBEDL_UID=0
PYYOUTUBEDL_GID=0
